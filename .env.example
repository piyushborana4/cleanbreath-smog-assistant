# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only, unless GOOGLE_GENAI_USE_VERTEXAI=true).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_API_KEY: Optional server-side key for Google Maps Air Quality & Geocoding APIs.
# When omitted, the backend gracefully falls back to Open-Meteo Air Quality & Geocoding.
GOOGLE_MAPS_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ALLOWED_ORIGINS: Comma-separated extra CORS origins allowed in production.
ALLOWED_ORIGINS=""

# ALLOW_EMBEDDING: Set to "true" ONLY for AI Studio / iframe preview environments.
# In production, leave unset or "false" to enforce strict frame-ancestors 'self' and X-Frame-Options: DENY.
ALLOW_EMBEDDING=false

# API_RATE_LIMIT_MAX / AI_RATE_LIMIT_MAX: 15-minute per-IP rate limits (generic /api vs Gemini routes).
API_RATE_LIMIT_MAX=90
AI_RATE_LIMIT_MAX=12

# CHAT_STREAM_TIMEOUT_MS / CHAT_MAX_CONCURRENT_PER_IP: SSE chat safety bounds.
CHAT_STREAM_TIMEOUT_MS=45000
CHAT_MAX_CONCURRENT_PER_IP=2

# FIREBASE_APP_CHECK_ENABLED: Set to "true" to enforce X-Firebase-AppCheck JWT verification on /api/*.
FIREBASE_APP_CHECK_ENABLED=false
FIREBASE_PROJECT_NUMBER=""
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=""

# GOOGLE_GENAI_USE_VERTEXAI: Set to "true" on Cloud Run to authenticate via Workload Identity / Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION=asia-south1

# PORT: Server listening port (3000 in AI Studio preview, configurable for Cloud Run).
PORT=3000

# NODE_ENV: development | production | test
NODE_ENV=development
