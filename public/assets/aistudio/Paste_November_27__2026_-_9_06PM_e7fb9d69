        thread.appendChild(botArt);

        const text = replies[question] || 'Based on Rohini’s current AQI of 248, keep windows closed this morning, use an N95 mask outdoors, and run your bedroom purifier tonight.';
        const target = botArt.querySelector('p');
        let idx = 0;
        const timer = setInterval(() => {
          idx += 4;
          target.textContent = text.slice(0, idx);
          if (idx >= text.length) clearInterval(timer);
        }, 25);
      }

      document.querySelectorAll('.suggest-chip').forEach((btn) => {
        btn.addEventListener('click', () => streamAnswer(btn.dataset.q));
      });
      document.getElementById('chat-form').addEventListener('submit', (e) => {
        e.preventDefault();
        const input = document.getElementById('chat-input');
        const val = input.value.trim();
        if (!val) return;
        input.value = '';
        streamAnswer(val);
      });
    })();
  </script>


