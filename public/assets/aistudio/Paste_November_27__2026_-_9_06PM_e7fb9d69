      });

      const replies = {
        'What is the best time to open windows today?': 'Open windows briefly between 1:00 PM and 3:00 PM for 15–20 minutes when afternoon sun lifts the smog layer. Close them again before 5:00 PM.',
        'How should I prep the bedroom for asthma?': 'Seal bottom door gaps with a damp towel, avoid incense or mosquito coils, and run your HEPA purifier on medium 30 minutes before bedtime.'
      };

      function streamAnswer(question) {
        const thread = document.getElementById('chat-thread');
        const userDiv = document.createElement('div');
        userDiv.className = 'self-end max-w-[85%] p-gutter-lg rounded-lg bg-light-primary dark:bg-dark-primary text-light-on-primary dark:text-dark-on-primary';
        userDiv.innerHTML = '<p class="font-body text-body-md"></p>';
        userDiv.querySelector('p').textContent = question;
        thread.appendChild(userDiv);

        const botArt = document.createElement('article');
        botArt.className = 'p-gutter-xl rounded-lg bg-light-surface-container-lowest dark:bg-dark-surface-container-low border border-light-outline-variant dark:border-dark-outline-variant flex flex-col gap-gutter-sm';
