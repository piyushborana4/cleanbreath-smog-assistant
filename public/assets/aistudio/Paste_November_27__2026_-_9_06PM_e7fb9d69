  <script>
    (function () {
      const root = document.documentElement;
      const themeBtn = document.getElementById('theme-toggle');
      try {
        if (localStorage.getItem('cb_theme') === 'dark') root.classList.add('dark');
      } catch (e) {}
      themeBtn.addEventListener('click', () => {
        root.classList.toggle('dark');
        try { localStorage.setItem('cb_theme', root.classList.contains('dark') ? 'dark' : 'light'); } catch (e) {}
      });

      let currentStep = 1;
      const labels = {
        1: 'Step 1 of 3 · Neighbourhood',
        2: 'Step 2 of 3 · Household',
        3: 'Step 3 of 3 · Lifestyle'
      };
      const nextLabels = {
        1: 'Next: Household',
        2: 'Next: Lifestyle',
        3: 'See today’s air plan'
      };

      function showStep(step) {
        currentStep = step;
        [1, 2, 3].forEach((n) => {
          const el = document.getElementById('step-' + n);
          const tab = document.querySelector('[data-step-tab="' + n + '"]');
          if (n === step) {
            el.classList.remove('hidden');
            el.classList.add('flex');
            tab.setAttribute('aria-selected', 'true');
            tab.className = 'h-2.5 rounded-full bg-light-primary dark:bg-dark-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-light-primary dark:focus-visible:ring-dark-primary';
          } else {
            el.classList.add('hidden');
            el.classList.remove('flex');
            tab.setAttribute('aria-selected', 'false');
            tab.className = 'h-2.5 rounded-full bg-light-surface-container-highest dark:bg-dark-surface-container-highest focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-light-primary dark:focus-visible:ring-dark-primary';
          }
        });
        document.getElementById('step-label').textContent = labels[step];
        document.getElementById('next-label').textContent = nextLabels[step];
        const prevBtn = document.getElementById('prev-btn');
        if (step === 1) prevBtn.classList.add('hidden');
        else prevBtn.classList.remove('hidden');
      }

      document.querySelectorAll('[data-step-tab]').forEach((btn) => {
        btn.addEventListener('click', () => showStep(Number(btn.dataset.stepTab)));
      });
      document.getElementById('prev-btn').addEventListener('click', () => {
        if (currentStep > 1) showStep(currentStep - 1);
      });
      document.getElementById('next-btn').addEventListener('click', () => {
        if (currentStep < 3) showStep(currentStep + 1);
        else window.location.href = '../dashboard/Dashboard.html';
      });

      document.querySelectorAll('.household-toggle').forEach((btn) => {
        btn.addEventListener('click', () => {
          const pressed = btn.getAttribute('aria-pressed') === 'true';
          btn.setAttribute('aria-pressed', String(!pressed));
          btn.classList.toggle('bg-light-secondary-container', !pressed);
          btn.classList.toggle('dark:bg-dark-secondary-container', !pressed);
          btn.classList.toggle('border-2', !pressed);
          btn.classList.toggle('border-light-primary', !pressed);
          btn.classList.toggle('dark:border-dark-primary', !pressed);
          btn.classList.toggle('bg-light-surface-container-lowest', pressed);
          btn.classList.toggle('dark:bg-dark-surface-container-low', pressed);
          btn.classList.toggle('border', pressed);
          btn.classList.toggle('border-light-outline-variant', pressed);
          btn.classList.toggle('dark:border-dark-outline-variant', pressed);
        });
      });
    })();
  </script>


