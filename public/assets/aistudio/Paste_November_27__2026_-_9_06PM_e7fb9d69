  <script>
    (function () {
      const root = document.documentElement;
      const themeBtn = document.getElementById('theme-toggle');
      try {
        if (localStorage.getItem('cb_theme') === 'dark') root.classList.add('dark');
      } catch (e) {}
      themeBtn.addEventListener('click', () => {
        root.classList.toggle('dark');
        try { localStorage.setItem('cb_theme', root.classList.contains('dark') ? 'dark' : 'light'); } catch (e) {}
      });

      document.querySelectorAll('.lang-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const isHi = btn.dataset.lang === 'hi';
          document.getElementById('settings-title').textContent = isHi ? 'सेटिंग्स और सुगम्यता' : 'Settings & Accessibility';
          document.getElementById('settings-sub').textContent = isHi ? 'भाषा, टेक्स्ट आकार और गोपनीयता चुनें।' : 'Personalize language, reading comfort, and privacy.';
          document.querySelectorAll('.lang-btn').forEach((b) => {
            const active = b === btn;
            b.setAttribute('aria-pressed', String(active));
            b.className = active
              ? 'lang-btn min-h-12 px-gutter-lg rounded-full bg-light-primary dark:bg-dark-primary text-light-on-primary dark:text-dark-on-primary font-label text-label-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-light-primary dark:focus-visible:ring-dark-primary'
              : 'lang-btn min-h-12 px-gutter-lg rounded-full bg-light-surface-container-low dark:bg-dark-surface-container-low border border-light-outline-variant dark:border-dark-outline-variant font-label text-label-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-light-primary dark:focus-visible:ring-dark-primary';
          });
        });
      });

      document.querySelectorAll('.size-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.body.style.fontSize = btn.dataset.size;
          document.querySelectorAll('.size-btn').forEach((b) => {
            const active = b === btn;
            b.setAttribute('aria-pressed', String(active));
            b.className = active
              ? 'size-btn min-h-12 px-gutter-md rounded-full bg-light-primary dark:bg-dark-primary text-light-on-primary dark:text-dark-on-primary font-label text-label-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-light-primary dark:focus-visible:ring-dark-primary'
              : 'size-btn min-h-12 px-gutter-md rounded-full bg-light-surface-container-low dark:bg-dark-surface-container-low border border-light-outline-variant dark:border-dark-outline-variant font-label text-label-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-light-primary dark:focus-visible:ring-dark-primary';
          });
        });
      });

      document.getElementById('clear-data-btn').addEventListener('click', () => {
        try { localStorage.removeItem('cb_theme'); } catch (e) {}
        document.getElementById('clear-status').classList.remove('hidden');
      });
    })();
  </script>


