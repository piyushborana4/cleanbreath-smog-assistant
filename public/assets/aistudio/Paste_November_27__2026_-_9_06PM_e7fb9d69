        if (localStorage.getItem('cb_theme') === 'dark') root.classList.add('dark');
      } catch (e) {}
      themeBtn.addEventListener('click', () => {
        root.classList.toggle('dark');
        try { localStorage.setItem('cb_theme', root.classList.contains('dark') ? 'dark' : 'light'); } catch (e) {}
      });

      window.applyFilter = function (filter) {
        document.querySelectorAll('.filter-chip').forEach((btn) => {
          const active = btn.dataset.filter === filter;
          btn.setAttribute('aria-pressed', String(active));
          btn.className = active
            ? 'filter-chip min-h-12 px-gutter-lg rounded-full bg-light-primary dark:bg-dark-primary text-light-on-primary dark:text-dark-on-primary font-label text-label-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-light-primary dark:focus-visible:ring-dark-primary'
