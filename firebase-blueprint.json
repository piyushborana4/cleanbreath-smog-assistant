{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated CleanBreath user preferences without sensitive PII exposure.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display label",
          "minLength": 1,
          "maxLength": 80
        },
        "preferredLanguage": {
          "type": "string",
          "enum": ["en", "hi"]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "preferredLanguage", "updatedAt"]
    },
    "HouseholdProfileDoc": {
      "title": "HouseholdProfileDoc",
      "description": "Saved household profile for air quality personalisation.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "city": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "locality": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "commuteMode": {
          "type": "string",
          "enum": [
            "walk_cycle",
            "two_wheeler",
            "public_transit",
            "car_solo",
            "carpool",
            "work_from_home"
          ]
        },
        "homeType": {
          "type": "string",
          "enum": [
            "apartment_high_rise",
            "apartment_low_rise",
            "independent_house",
            "shared_housing"
          ]
        },
        "ownsAirPurifier": {
          "type": "boolean"
        },
        "budgetLevel": {
          "type": "string",
          "enum": ["low", "medium", "flexible"]
        },
        "language": {
          "type": "string",
          "enum": ["en", "hi"]
        },
        "household": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "city",
        "locality",
        "commuteMode",
        "homeType",
        "ownsAirPurifier",
        "budgetLevel",
        "language",
        "household",
        "createdAt",
        "updatedAt"
      ]
    },
    "SavedPlanDoc": {
      "title": "SavedPlanDoc",
      "description": "Saved personalized daily air-quality plan snapshot.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "locationLabel": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "aqi": {
          "type": "number"
        },
        "category": {
          "type": "string",
          "enum": ["good", "moderate", "sensitive", "unhealthy", "very_unhealthy", "severe"]
        },
        "personalizationSummary": {
          "type": "string",
          "minLength": 5,
          "maxLength": 400
        },
        "planData": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "locationLabel",
        "aqi",
        "category",
        "personalizationSummary",
        "planData",
        "createdAt"
      ]
    },
    "CommunityChecklistDoc": {
      "title": "CommunityChecklistDoc",
      "description": "Shareable community action checklist for an apartment society or school.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "isPublic": {
          "type": "boolean"
        },
        "settingType": {
          "type": "string",
          "enum": ["apartment_society", "school"]
        },
        "locality": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "aqi": {
          "type": "number"
        },
        "shareableText": {
          "type": "string",
          "minLength": 10,
          "maxLength": 4000
        },
        "items": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerUid",
        "isPublic",
        "settingType",
        "locality",
        "aqi",
        "shareableText",
        "items",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "User preference document owned strictly by userId."
    },
    "/users/{userId}/profiles/{profileId}": {
      "schema": { "$ref": "#/entities/HouseholdProfileDoc" },
      "description": "Saved household profile for the user."
    },
    "/users/{userId}/plans/{planId}": {
      "schema": { "$ref": "#/entities/SavedPlanDoc" },
      "description": "Saved daily CleanBreath action plans."
    },
    "/community_checklists/{checklistId}": {
      "schema": { "$ref": "#/entities/CommunityChecklistDoc" },
      "description": "Shareable neighbourhood or school checklists."
    }
  }
}
